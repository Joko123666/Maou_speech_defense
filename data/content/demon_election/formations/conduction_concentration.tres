[gd_resource type="Resource" script_class="TowerFormationData" format=3]

[ext_resource type="Script" path="res://resources/formation_cell_data.gd" id="1_uctlw"]
[ext_resource type="Script" path="res://resources/tower_formation_data.gd" id="2_sqnm1"]

[sub_resource type="Resource" id="Resource_lsygk"]
script = ExtResource("1_uctlw")
