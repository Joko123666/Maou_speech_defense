[resource]
script = ExtResource("1_stage")
id = &"standard_20m"
display_name = "10분 표준 스테이지"
duration_seconds = 600.0
initial_spawn_interval = 1.45
minimum_spawn_interval = 0.42
initial_health_multiplier = 1.3
final_health_multiplier = 4.2
final_speed_multiplier = 1.55
enemy = ExtResource("2_enemy")
boss_times = Array[float]([150.0, 300.0, 450.0, 600.0])
default_boss_ids = Array[StringName]([&"boss_5", &"boss_10", &"boss_15", &"final_boss"])
final_boss_id = &"final_boss"
artifact_elite_interval_seconds = 120.0
artifact_elite_enemy_id = &"steel_golem"
artifact_elite_health_multipliers = Array[float]([3.0, 5.0, 8.0, 12.0])
spawn_table = Array[Dictionary]([{
"end": 90.0,
"groups": {"civilian_slime": 3, "goblin_raider": 2},
"start": 0.0,
"weights": {"civilian_slime": 7.0, "goblin_raider": 3.0}
}, {
"end": 180.0,
"groups": {"civilian_slime": 3, "goblin_raider": 2},
"start": 90.0,
"weights": {"civilian_slime": 5.0, "goblin_raider": 5.0, "orc_shield": 2.0, "skeleton_raider": 3.0}
}, {
"end": 300.0,
"groups": {"civilian_slime": 3, "goblin_raider": 2, "skeleton_raider": 2},
"start": 180.0,
"weights": {"civilian_slime": 2.0, "goblin_raider": 2.0, "orc_shield": 3.0, "skeleton_raider": 4.0}
}, {
"end": 420.0,
"groups": {"civilian_slime": 3, "goblin_raider": 2, "hound_light_infantry": 1, "skeleton_raider": 2},
"start": 300.0,
"weights": {"goblin_raider": 2.0, "hound_light_infantry": 3.0, "orc_shield": 3.0, "skeleton_raider": 3.0, "wraith_raider": 2.0}
}, {
"end": 540.0,
"groups": {"goblin_raider": 2, "hound_light_infantry": 1, "skeleton_raider": 2, "steel_golem": 1},
"start": 420.0,
"weights": {"goblin_raider": 1.0, "hound_light_infantry": 4.0, "orc_shield": 3.0, "skeleton_raider": 3.0, "steel_golem": 1.0, "wraith_raider": 3.0}
}, {
"end": 600.1,
"groups": {"hound_light_infantry": 1, "skeleton_raider": 2, "steel_golem": 1},
"start": 540.0,
"weights": {"hound_light_infantry": 4.0, "orc_shield": 3.0, "skeleton_raider": 4.0, "steel_golem": 2.0, "wraith_raider": 4.0}
}])
spawn_phases = Array[ExtResource("3_phase")]([SubResource("SpawnPhase_early"), SubResource("SpawnPhase_opening"), SubResource("SpawnPhase_mid"), SubResource("SpawnPhase_pressure"), SubResource("SpawnPhase_late"), SubResource("SpawnPhase_final")])
spawn_packets = Array[ExtResource("4_packet")]([SubResource("SpawnPacket_breakthrough"), SubResource("SpawnPacket_escort"), SubResource("SpawnPacket_siege")])
faction_preludes = Array[ExtResource("5_prelude")]([SubResource("FactionPrelude_first"), SubResource("FactionPrelude_second"), SubResource("FactionPrelude_third"), SubResource("FactionPrelude_final")])
faction_spawn_packets = Array[ExtResource("6_faction_packet")]([SubResource("FactionPacket_partason"), SubResource("FactionPacket_jiane"), SubResource("FactionPacket_kasuha"), SubResource("FactionPacket_irelai"), SubResource("FactionPacket_judaginda")])
