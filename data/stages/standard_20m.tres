[ext_resource type="Script" path="res://resources/faction_spawn_packet_data.gd" id="6_faction_packet"]

[sub_resource type="Resource" id="FactionPrelude_first"]
script = ExtResource("5_prelude")

[sub_resource type="Resource" id="FactionPrelude_second"]
